<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      纯 Compose 工程，主题只需保证：无 ActionBar / 全黑底 / 透明系统栏 / 允许延伸到刘海区。
      Compose 侧再用 WindowInsetsControllerCompat 做沉浸式。
    -->
    <style name="Theme.SportsCam" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- 副屏是异形屏：允许内容延伸到圆角/挖孔区域 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- 通知栏方向按钮的样式（RemoteViews 布局要用） -->
    <style name="NotifButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/bg_notif_button</item>
    </style>
</resources>
